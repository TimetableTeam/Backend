# Copy this file to .env and fill in real values. Never commit .env.

# postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

PORT=5000
NODE_ENV=development

# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Comma-separated list of allowed frontend origins for CORS.
FRONTEND_URL=http://localhost:5173

# Super Admin account. Email must match the account this project requires.
# The password below is set locally by you - it is NEVER committed anywhere.
SUPER_ADMIN_EMAIL=engramzy9@gmail.com
SUPER_ADMIN_PASSWORD=

# Dev-only: when true (default outside production), OTP codes for non-Super-Admin
# logins are returned directly in the /auth/login response (and logged to the
# console) since this project has no real email server. MUST be false/unset in
# production - set NODE_ENV=production to disable it automatically.
DEV_EXPOSE_OTP=true
